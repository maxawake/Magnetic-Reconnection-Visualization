<ServerManagerConfiguration>
 <ProxyGroup name="filters">
  <SourceProxy
      name="ParallelVectors"
      class="vtkParallelVectors"
      label="VTK Parallel Vectors">

    <InputProperty name="Input" command="SetInputConnection">
      <ProxyGroupDomain name="groups">
        <Group name="sources"/>
        <Group name="filters"/>
      </ProxyGroupDomain>
      <DataTypeDomain name="input_type">
        <DataType value="vtkDataSet"/>
      </DataTypeDomain>
    </InputProperty>

    <StringVectorProperty
        name="FirstVectorFieldName"
        command="SetFirstVectorFieldName"
        number_of_elements="1"
        panel_visibility="default">
      <ArrayListDomain name="vectors1" attribute_type="Vectors">
        <RequiredProperties>
          <Property name="Input" function="Input"/>
        </RequiredProperties>
      </ArrayListDomain>
      <InputArrayDomain name="array_vector" number_of_components="3"/>
    </StringVectorProperty>

    <StringVectorProperty
        name="SecondVectorFieldName"
        command="SetSecondVectorFieldName"
        number_of_elements="1"
        panel_visibility="default">
      <ArrayListDomain name="vectors2" attribute_type="Vectors">
        <RequiredProperties>
          <Property name="Input" function="Input"/>
        </RequiredProperties>
      </ArrayListDomain>
      <InputArrayDomain name="array_vector2" number_of_components="3"/>
    </StringVectorProperty>

    <Documentation
      short_help="Extract lines where two vector fields are parallel"
      long_help="Runs vtkParallelVectors to generate polylines corresponding to the Peikert &amp; Roth parallel-vectors operator.  You must choose two 3-component point arrays.">
    </Documentation>

  </SourceProxy>
 </ProxyGroup>
</ServerManagerConfiguration>
