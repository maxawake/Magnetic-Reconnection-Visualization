<ServerManagerConfiguration>
  <ProxyGroup name="filters">
    <SourceProxy name="BifurcationLine"
                 class="vtkBifurcationLineMSR"
                 label="Bifurcation Line">
      <InputProperty name="Input"
                     command="SetInputConnection"
                     port_index="0">
        <DataTypeDomain name="input_type">
          <DataType value="vtkDataSet"/>
        </DataTypeDomain>
      </InputProperty>
      <DoubleVectorProperty name="AngleThreshold"
                            command="SetAngleThreshold"
                            default_values="0.5"
                            number_of_elements="1">
        <DoubleRangeDomain name="range" min="0.0" max="3.14"/>
      </DoubleVectorProperty>
      <DoubleVectorProperty name="HyperbolicityThreshold"
                            command="SetHyperbolicityThreshold"
                            default_values="0.01"
                            number_of_elements="1">
        <DoubleRangeDomain name="range" min="0.0" max="1.0"/>
      </DoubleVectorProperty>
    </SourceProxy>
  </ProxyGroup>
</ServerManagerConfiguration>
