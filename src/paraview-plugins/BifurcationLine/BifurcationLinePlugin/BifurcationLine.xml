<ServerManagerConfiguration>
  <ProxyGroup name="filters">
    <SourceProxy name="BifurcationLine"
                 class="vtkBifurcationLine"
                 label="MRVIS Bifurcation Line Filter">

      <!-- Input -->
      <InputProperty name="Input" command="SetInputConnection">
        <ProxyGroupDomain name="groups">
          <Group name="filters"/>
          <Group name="sources"/>
        </ProxyGroupDomain>
        <DataTypeDomain name="input_type">
          <DataType value="vtkDataSet"/>
        </DataTypeDomain>
      </InputProperty>

      <!-- Primary Vector -->
      <StringVectorProperty name="PrimaryVectorFieldName"
                            command="SetPrimaryVectorFieldName"
                            label="Primary Vector Field"
                            number_of_elements="1"
                            panel_widget="ArraySelection">
        <ArrayListDomain name="array_list">
          <RequiredProperties>
            <Property name="Input" function="Input"/>
          </RequiredProperties>
          <FieldAssociationDomain name="assoc">
            <AttributeType value="POINT"/>
          </FieldAssociationDomain>
          <NumberOfComponents value="3"/>
        </ArrayListDomain>
      </StringVectorProperty>

      <!-- Secondary Vector (optional) -->
      <StringVectorProperty name="SecondaryVectorFieldName"
                            command="SetSecondaryVectorFieldName"
                            label="Secondary Vector Field"
                            number_of_elements="1"
                            panel_widget="OptionalArraySelection">
        <ArrayListDomain name="array_list" optional="1">
          <RequiredProperties>
            <Property name="Input" function="Input"/>
          </RequiredProperties>
          <FieldAssociationDomain name="assoc">
            <AttributeType value="POINT"/>
          </FieldAssociationDomain>
          <NumberOfComponents value="3"/>
        </ArrayListDomain>
        <Documentation>
          Optional 3-component point-data. Leave blank to compute acceleration automatically.
        </Documentation>
      </StringVectorProperty>

      <!-- Threshold toggle & slider (min fixed at 0) -->
      <IntVectorProperty name="EnableThreshold"
                         command="SetEnableThreshold"
                         label="Enable Thresholding"
                         number_of_elements="1"
                         default_values="0">
        <BooleanDomain name="bool"/>
      </IntVectorProperty>
      <DoubleVectorProperty name="MaximumCriterion"
                            command="SetMaximumCriterion"
                            label="Max –λ₁·λ₂"
                            number_of_elements="1"
                            default_values="1.0e6"
                            panel_widget="Slider">
        <DoubleRangeDomain name="range" min="0.0" max="10"/>
        <Documentation>
          Maximum –λ₁·λ₂ (minimum is always 0).
        </Documentation>
      </DoubleVectorProperty>

      <!-- Length filter toggle & slider -->
      <IntVectorProperty name="EnableLengthFilter"
                         command="SetEnableLengthFilter"
                         label="Enable Length Filter"
                         number_of_elements="1"
                         default_values="0">
        <BooleanDomain name="bool"/>
      </IntVectorProperty>
      <IntVectorProperty name="MinimumCells"
                         command="SetMinimumCells"
                         label="Minimum # Cells"
                         number_of_elements="1"
                         default_values="2"
                         panel_widget="Slider">
        <IntRangeDomain name="range" min="1" max="100"/>
        <Documentation>
          Discard any polyline shorter than this many cells.
        </Documentation>
      </IntVectorProperty>

      <!-- Angle filter toggle & slider -->
      <IntVectorProperty name="EnableAngleFilter"
                         command="SetEnableAngleFilter"
                         label="Enable Angle Filter"
                         number_of_elements="1"
                         default_values="0">
        <BooleanDomain name="bool"/>
      </IntVectorProperty>
      <DoubleVectorProperty name="MaximumTangentAngle"
                            command="SetMaximumTangentAngle"
                            label="Max Turn Angle (°)"
                            number_of_elements="1"
                            default_values="45.0"
                            panel_widget="Slider">
        <DoubleRangeDomain name="range" min="0.0" max="180.0"/>
        <Documentation>
          Discard segments whose turn exceeds this angle (in degrees).
        </Documentation>
      </DoubleVectorProperty>

      <!-- hidden output -->
      <ProxyProperty name="Output"
                     command="GetOutputPort"
                     panel_visibility="never"/>

    </SourceProxy>
  </ProxyGroup>
</ServerManagerConfiguration>
