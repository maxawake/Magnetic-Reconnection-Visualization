<ServerManagerConfiguration>
    <ProxyGroup name="filters">
        <SourceProxy name="prtlMyFilter"
                     class="prtlMyFilter"
                     label="PRTL MyFilter">
            <InputProperty
                    name="Input"
                    command="SetInputConnection"
                    label="Input">
                <ProxyGroupDomain name="groups">
                    <Group name="sources"/>
                    <Group name="filters"/>
                </ProxyGroupDomain>
                <DataTypeDomain name="input_type">
                    <DataType value="vtkImageData"/>
                </DataTypeDomain>
            </InputProperty>

            <Hints>
                <ShowInMenu category="prtl" />
            </Hints>
        </SourceProxy>
    </ProxyGroup>
</ServerManagerConfiguration>
